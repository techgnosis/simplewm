#!/bin/sh
# /sbin/init, PID 1: mount the basics, start udevd (devices) and seatd (screen and input
# access) as root, then run simplewm as the user, and start it again if it exits.
#
# For development, root shells with no password run on the serial console (ttyS0) and on
# tty2 (Ctrl+Alt+F2). They go before this runs on a real machine.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root

USER_NAME=user

log() {
    echo "init: $*" > /dev/console
}

mount -t proc proc /proc
mount -t sysfs sys /sys
mountpoint -q /dev || mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev shm /dev/shm
mount -t tmpfs -o mode=755,nosuid,nodev run /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmp /tmp
hostname -F /etc/hostname
ip link set lo up
mkdir -p /var/log

# busybox's poweroff, reboot and halt signal PID 1 with USR2, TERM and USR1.
shutdown() {
    log "shutting down"
    kill -TERM -1 2>/dev/null
    sleep 2
    kill -KILL -1 2>/dev/null
    sync
    mount -o remount,ro /
    "$1" -f
}
trap 'shutdown poweroff' USR2
trap 'shutdown reboot' TERM
trap 'shutdown halt' USR1

# --- devices: udevd (eudev) ------------------------------------------------------------
# udevd follows its rules: it loads drivers for new devices, gives /dev files their
# groups, marks sound cards ready for PipeWire, and tells simplewm, libinput and PipeWire
# about devices that come and go. --daemon returns once it's listening.
udevd --daemon
# Replay the devices that were there before udevd started, so their drivers load, and
# wait until it has handled them all.
udevadm trigger --action=add --type=subsystems
udevadm trigger --action=add --type=devices
udevadm settle --timeout=10

# --- seat: seatd ---------------------------------------------------------------------
# seatd opens the GPU and input devices for members of the seat group, and switches
# virtual terminals. It says it's ready on fd 3.
mkfifo /run/seatd.ready
seatd -g seat -n 3 3>/run/seatd.ready >>/var/log/seatd.log 2>&1 &
read -r _ < /run/seatd.ready
rm /run/seatd.ready

# --- development shells --------------------------------------------------------------
for tty in ttyS0 tty2; do
    [ -c /dev/$tty ] || continue
    (
        while :; do
            setsid -c sh -l <>/dev/$tty >&0 2>&0
            sleep 1
        done
    ) &
done

# --- simplewm --------------------------------------------------------------------------
uid=$(id -u "$USER_NAME")
runtime=/run/user/$uid
mkdir -p "$runtime"
chown "$USER_NAME:$USER_NAME" "$runtime"
chmod 700 "$runtime"

# udevadm settle should have waited for the GPU's driver; give it a moment more anyway.
i=0
while [ ! -e /dev/dri/card0 ] && [ $i -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
[ -e /dev/dri/card0 ] || log "no GPU (/dev/dri/card0) yet; starting simplewm anyway"

(
    while :; do
        log "starting simplewm as $USER_NAME (log: ~$USER_NAME/simplewm.log)"
        # su -l: the user's own ID and groups (seat, audio, video, input, wheel), HOME and
        # the login PATH.
        su -l "$USER_NAME" -c "export XDG_RUNTIME_DIR=$runtime; exec simplewm >>simplewm.log 2>&1"
        log "simplewm exited ($?); starting it again in 2 s"
        sleep 2
    done
) &

# PID 1 must never exit. `wait` also reaps orphans that end up as our children.
while :; do
    wait
    sleep 1
done
