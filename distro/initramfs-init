#!/bin/busybox sh
# The initramfs's /init: load the disk and filesystem drivers, mount the root filesystem
# named by root= on the kernel command line, and hand over to its /sbin/init.
/bin/busybox --install -s /bin
export PATH=/bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

rescue() {
    echo "initramfs: $1; here's a shell"
    exec sh
}

while read -r m; do
    insmod "/modules/$m" || echo "initramfs: couldn't load $m"
done < /modules/order

root=
for arg in $(cat /proc/cmdline); do
    case $arg in root=*) root=${arg#root=} ;; esac
done
[ -n "$root" ] || rescue "no root= on the kernel command line"

# The disk shows up a moment after its driver loads.
i=0
while [ ! -b "$root" ] && [ $i -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
[ -b "$root" ] || rescue "$root didn't show up"

mount -t ext4 -o rw "$root" /newroot || rescue "couldn't mount $root"

umount /proc /sys
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
